{
  "name": "teleglass",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:i18n": "node scripts/check-i18n.mjs",
    "build": "node scripts/check-i18n.mjs && node scripts/check-format.mjs && tsc -b && vite build",
    "check:format": "node scripts/check-format.mjs",
    "lint": "oxlint",
    "simulate": "evenhub-simulator http://localhost:5173 --automation-port 9898",
    "qr": "evenhub qr --port 5173 --http",
    "pack": "npm run build && evenhub pack app.json dist --sdk-ver 0.0.16"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/pretext": "^0.1.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.6"
  }
}
